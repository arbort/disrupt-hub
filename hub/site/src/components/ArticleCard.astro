---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<a class="article-card" href={href}>
  <span class="article-card__title">{title}</span>
  <span class="article-card__arrow">→</span>
</a>

<style>
  .article-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-16);
    padding: var(--ui-space-20) var(--ui-space-24);
    border-radius: var(--ui-radius-16);
    background: var(--elevation-1);
    border: 1px solid var(--primary-8);
    text-decoration: none;
    color: var(--primary);
  }
  .article-card:hover {
    border-color: var(--primary-20);
  }
  .article-card__arrow {
    color: var(--primary-40);
  }
</style>
