<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__logo">Disrupt-Hub</a>
    <nav class="site-header__nav">
      <a href="/">Продукты</a>
      <a href="/submit/">Прислать статью</a>
      <a href="https://t.me/disrupt_team">Канал</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--primary-10);
    padding: var(--ui-space-24) 0;
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-16);
    flex-wrap: wrap;
  }
  .site-header__logo {
    font-weight: 700;
    text-decoration: none;
    font-size: var(--ui-title-20-font-size);
  }
  .site-header__nav {
    display: flex;
    gap: var(--ui-space-24);
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--primary-70);
  }
  .site-header__nav a:hover {
    color: var(--primary);
  }
</style>
