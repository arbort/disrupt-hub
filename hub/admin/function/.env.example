# Переменные окружения Cloud Function — прописываются в консоли Yandex Cloud
# при создании функции, этот файл только документирует набор. Не коммитить
# реальные значения никуда.

BUCKET_NAME=disrupt-hub-content
ADMIN_SECRET=замени-на-длинную-случайную-строку
AWS_ACCESS_KEY_ID=замени-на-static-key-id-сервис-аккаунта-disrupt-hub-content-sa
AWS_SECRET_ACCESS_KEY=замени-на-static-key-secret-того-же-сервис-аккаунта
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
